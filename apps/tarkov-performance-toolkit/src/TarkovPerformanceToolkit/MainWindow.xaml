<Window x:Class="TarkovPerformanceToolkit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tarkov Performance Toolkit" Icon="Assets/AppIcon.png"
        Width="940" Height="700" MinWidth="760" MinHeight="560"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="54"/></Grid.RowDefinitions>
    <Grid Margin="24,20,24,14">
      <StackPanel>
        <TextBlock Text="TARKOV PERFORMANCE TOOLKIT" Foreground="{StaticResource AccentBrush}" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="Read-only system, configuration and benchmark diagnostics" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
      </StackPanel>
    </Grid>

    <TabControl Grid.Row="1" Margin="24,0,24,12" SelectedIndex="0">
      <TabItem Header="Overview">
        <Grid Margin="0,14,0,16">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="16">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock x:Name="StatusText" Text="Ready" FontSize="15"/><TextBlock x:Name="DetailText" Text="No data is uploaded automatically." Foreground="{StaticResource MutedBrush}" Margin="0,5,16,0" TextWrapping="Wrap"/></StackPanel>
              <Button Grid.Column="1" x:Name="InspectButton" Content="Collect report" Click="Inspect_Click"/>
            </Grid>
          </Border>
          <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal"><TextBlock Text="SANITIZED REPORT" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CopyButton" Content="Copy JSON" Margin="18,0,0,0" IsEnabled="False" Click="Copy_Click"/><Button x:Name="SaveButton" Content="Save JSON" Margin="8,0,0,0" IsEnabled="False" Click="Save_Click"/><Button Content="Open data folder" Margin="8,0,0,0" Click="OpenFolder_Click"/></StackPanel></StackPanel>
              <TextBox Grid.Row="1" x:Name="ReportText" Margin="0,12,0,0" MinHeight="140" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Text="Collect a report to preview sanitized JSON."/>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Benchmark">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
          <ContentControl x:Name="BenchmarkRoot" MinWidth="680"/>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Goal">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Margin="0,14,0,16" Width="560" HorizontalAlignment="Left" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="20">
          <StackPanel>
            <TextBlock Text="ACTIVE GOAL" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
            <TextBlock Text="Goal" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,4"/><TextBox x:Name="GoalText"/>
            <TextBlock Text="Target FPS" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,4"/><TextBox x:Name="TargetText"/>
            <TextBlock Text="Quality preference" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,4"/><TextBox x:Name="QualityText" TextWrapping="Wrap" MinHeight="70" AcceptsReturn="True"/>
            <Button Content="Save goal" Margin="0,16,0,0" HorizontalAlignment="Left" MinWidth="130" Style="{StaticResource PrimaryButton}" Click="SaveGoal_Click"/>
          </StackPanel>
        </Border>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Grid Grid.Row="2" Margin="24,0,24,12">
      <TextBlock Text="Tarkov Performance Toolkit by TimmyTook" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="Unofficial community tool · local data only" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="About" Padding="10,4" Click="About_Click"/></StackPanel>
    </Grid>
  </Grid>
</Window>
