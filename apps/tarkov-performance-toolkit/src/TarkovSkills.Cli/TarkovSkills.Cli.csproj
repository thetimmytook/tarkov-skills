<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TarkovSkills</AssemblyName>
    <RootNamespace>TarkovSkills.Cli</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationIcon>..\..\packaging\Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\TarkovSkills.Core\TarkovSkills.Core.csproj" />
    <Content Include="..\..\..\tarkov-performance-benchmark\src\TarkovPerformanceBenchmark\third_party\presentmon\PresentMon.exe" Link="tools\PresentMon\PresentMon.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\tarkov-performance-benchmark\src\TarkovPerformanceBenchmark\third_party\presentmon\LICENSE.txt" Link="tools\PresentMon\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\tarkov-performance-benchmark\src\TarkovPerformanceBenchmark\third_party\presentmon\dependency.json" Link="tools\PresentMon\dependency.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
