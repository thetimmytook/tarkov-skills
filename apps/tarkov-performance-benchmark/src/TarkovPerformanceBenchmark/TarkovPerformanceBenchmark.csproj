<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>TarkovPerformanceBenchmark</AssemblyName>
    <RootNamespace>TarkovPerformanceBenchmark</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationIcon>..\..\packaging\Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <Import Project="..\..\..\..\build\StoreProductVersion.props" />

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\TarkovSkills.Core\TarkovSkills.Core.csproj" />
    <ProjectReference Include="..\..\..\..\src\TarkovBenchmark.Feature\TarkovBenchmark.Feature.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\packaging\Assets\AppIcon.png" Link="Assets\AppIcon.png" />
    <Content Include="third_party\presentmon\PresentMon.exe" CopyToOutputDirectory="PreserveNewest" TargetPath="tools\PresentMon\PresentMon.exe" />
    <Content Include="third_party\presentmon\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" TargetPath="tools\PresentMon\LICENSE.txt" />
    <Content Include="third_party\presentmon\dependency.json" CopyToOutputDirectory="PreserveNewest" TargetPath="tools\PresentMon\dependency.json" />
  </ItemGroup>

</Project>
