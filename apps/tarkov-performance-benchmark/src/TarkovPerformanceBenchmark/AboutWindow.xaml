<Window x:Class="TarkovPerformanceBenchmark.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AcademyAboutWindow}" WindowStartupLocation="CenterOwner"
        Title="About Tarkov Performance Benchmark" Icon="Assets/AppIcon.png">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="TARKOV PERFORMANCE BENCHMARK" Style="{StaticResource AboutHeading}" />
            <TextBlock x:Name="VersionText" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,24,0,24">
            <TextBlock Text="Created by TimmyTook" FontSize="14" />
            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Text="A read-only community utility for repeatable Escape from Tarkov FPS and frametime measurements." />
            <TextBlock Margin="0,20,0,0" Text="Privacy" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Text="Benchmark data stays on this PC unless you explicitly choose to upload it. The application does not read game memory or modify Tarkov files." />
            <TextBlock Margin="0,20,0,0" Text="Third-party software" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Text="Includes PresentMon 2.5.1 under the MIT License." />
            <TextBlock Margin="0,16,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Text="Unofficial community tool. Not affiliated with or endorsed by Battlestate Games." />
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="GitHub" Width="96" Click="GitHub_Click" />
                <Button Content="Privacy policy" Margin="8,0,0,0" Click="Privacy_Click" />
            </StackPanel>
            <Button Grid.Column="2" Content="Close" Width="96" HorizontalAlignment="Right" Click="Close_Click" />
        </Grid>
    </Grid>
</Window>
