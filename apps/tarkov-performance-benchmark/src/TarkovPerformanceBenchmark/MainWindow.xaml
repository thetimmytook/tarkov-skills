<Window Style="{StaticResource AcademyWindow}" x:Class="TarkovPerformanceBenchmark.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tarkov Performance Benchmark" Icon="Assets/AppIcon.png"
        Width="960" Height="820" MinWidth="700" MinHeight="520"
        MaxHeight="{Binding Height, Source={x:Static SystemParameters.WorkArea}}"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer x:Name="BenchmarkScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
      <ContentControl x:Name="ContentRoot" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" VerticalAlignment="Top"/>
    </ScrollViewer>
    <Border x:Name="Footer" Grid.Row="1" Padding="24,12,24,16" MinHeight="64"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="FooterAuthor" Text="Tarkov Performance Benchmark by TimmyTook"
                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,16,0" TextWrapping="Wrap"/>
        <StackPanel x:Name="FooterActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Unofficial community tool" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
          <Button x:Name="AboutButton" Content="About" MinWidth="64" Padding="12,6" VerticalAlignment="Center" Click="About_Click"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
