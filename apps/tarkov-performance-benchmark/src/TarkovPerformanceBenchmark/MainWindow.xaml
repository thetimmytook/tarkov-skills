<Window x:Class="TarkovPerformanceBenchmark.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tarkov Performance Benchmark" Icon="Assets/AppIcon.png"
        Width="800" Height="580" MinWidth="700" MinHeight="520"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="50"/></Grid.RowDefinitions>
    <ContentControl x:Name="ContentRoot"/>
    <Grid Grid.Row="1" Margin="22,0,22,12">
      <TextBlock Text="Tarkov Performance Benchmark by TimmyTook" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <TextBlock Text="Unofficial community tool" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
        <Button Content="About" Padding="10,3" BorderThickness="0" Click="About_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
