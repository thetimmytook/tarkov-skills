<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Timmy Academy theme.ts is authoritative. WPF uses device-independent units
         and Windows system fonts instead of copying CSS or web-only WOFF2 assets. -->
    <Color x:Key="Palette.neutral.950">#0B1115</Color>
    <Color x:Key="Palette.neutral.900">#10181D</Color>
    <Color x:Key="Palette.neutral.850">#142027</Color>
    <Color x:Key="Palette.neutral.800">#19252C</Color>
    <Color x:Key="Palette.neutral.700">#26343D</Color>
    <Color x:Key="Palette.neutral.600">#3A4953</Color>
    <Color x:Key="Palette.neutral.500">#61707A</Color>
    <Color x:Key="Palette.neutral.400">#8C989F</Color>
    <Color x:Key="Palette.neutral.300">#B6C0C5</Color>
    <Color x:Key="Palette.neutral.200">#D3DADD</Color>
    <Color x:Key="Palette.neutral.100">#E9EDEF</Color>
    <Color x:Key="Palette.neutral.50">#F6F8F8</Color>
    <Color x:Key="Palette.green.950">#0D2419</Color>
    <Color x:Key="Palette.green.900">#123321</Color>
    <Color x:Key="Palette.green.800">#18452D</Color>
    <Color x:Key="Palette.green.700">#215C3B</Color>
    <Color x:Key="Palette.green.600">#2D774C</Color>
    <Color x:Key="Palette.green.500">#3E9660</Color>
    <Color x:Key="Palette.green.400">#57B978</Color>
    <Color x:Key="Palette.green.300">#7ACE96</Color>
    <Color x:Key="Palette.green.200">#A8E1B7</Color>
    <Color x:Key="Palette.green.100">#D4F1DC</Color>
    <Color x:Key="Palette.blue.950">#101F2D</Color>
    <Color x:Key="Palette.blue.800">#173C63</Color>
    <Color x:Key="Palette.blue.700">#20558A</Color>
    <Color x:Key="Palette.blue.600">#2C6FB2</Color>
    <Color x:Key="Palette.blue.500">#3A86D8</Color>
    <Color x:Key="Palette.blue.400">#5C9BE1</Color>
    <Color x:Key="Palette.blue.300">#88B6EA</Color>
    <Color x:Key="Palette.amber.950">#292113</Color>
    <Color x:Key="Palette.amber.700">#7A5519</Color>
    <Color x:Key="Palette.amber.600">#93691E</Color>
    <Color x:Key="Palette.amber.500">#B48329</Color>
    <Color x:Key="Palette.amber.400">#D2A44B</Color>
    <Color x:Key="Palette.red.950">#2C1919</Color>
    <Color x:Key="Palette.red.700">#753833</Color>
    <Color x:Key="Palette.red.600">#91463F</Color>
    <Color x:Key="Palette.red.500">#B45A50</Color>
    <Color x:Key="Palette.red.400">#D3766C</Color>
    <Color x:Key="Palette.red.300">#E79A91</Color>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Palette.neutral.950}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Palette.neutral.900}" />
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="{StaticResource Palette.neutral.850}" />
    <SolidColorBrush x:Key="TabBodyBrush" Color="{StaticResource Palette.neutral.950}" />
    <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource Palette.neutral.800}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Palette.neutral.700}" />
    <SolidColorBrush x:Key="StrongBorderBrush" Color="{StaticResource Palette.neutral.600}" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="{StaticResource Palette.neutral.500}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Palette.neutral.100}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Palette.neutral.400}" />
    <SolidColorBrush x:Key="FaintBrush" Color="{StaticResource Palette.neutral.500}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Palette.green.400}" />
    <SolidColorBrush x:Key="BrandHoverBrush" Color="{StaticResource Palette.green.300}" />
    <SolidColorBrush x:Key="BrandStrongBrush" Color="{StaticResource Palette.green.500}" />
    <SolidColorBrush x:Key="BrandSubtleBrush" Color="{StaticResource Palette.green.900}" />
    <SolidColorBrush x:Key="ActionBrush" Color="{StaticResource Palette.blue.400}" />
    <SolidColorBrush x:Key="ActionHoverBrush" Color="{StaticResource Palette.blue.300}" />
    <SolidColorBrush x:Key="ActionSubtleBrush" Color="{StaticResource Palette.blue.800}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Palette.blue.300}" />
    <SolidColorBrush x:Key="InfoBackgroundBrush" Color="{StaticResource Palette.blue.950}" />
    <SolidColorBrush x:Key="InfoBorderBrush" Color="{StaticResource Palette.blue.800}" />
    <SolidColorBrush x:Key="ReadyBrush" Color="{StaticResource Palette.green.300}" />
    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="{StaticResource Palette.green.900}" />
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="{StaticResource Palette.green.700}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Palette.amber.400}" />
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="{StaticResource Palette.amber.950}" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="{StaticResource Palette.amber.700}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Palette.red.400}" />
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="{StaticResource Palette.red.950}" />
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="{StaticResource Palette.red.700}" />
    <SolidColorBrush x:Key="ErrorHoverBrush" Color="{StaticResource Palette.red.300}" />
    <FontFamily x:Key="BodyFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MetricFont">Consolas</FontFamily>
    <Style x:Key="AcademyWindow" TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="KeyboardFocus" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderThickness="2" CornerRadius="6" BorderBrush="{StaticResource ActionBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontWeight="{TemplateBinding FontWeight}" ContentSource="Content" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource ActionBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource BackgroundBrush}" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrandHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource BrandStrongBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2,0,0,0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource ActionBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource BrandSubtleBrush}" />
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="ComboBorder" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}" CornerRadius="6">
                                        <Grid>
                                            <ContentPresenter Margin="9,4,34,4" VerticalAlignment="Center" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                            <Path Width="8" Height="5" Margin="0,0,11,0" HorizontalAlignment="Right" VerticalAlignment="Center" Fill="{StaticResource AccentBrush}" Data="M 0 0 L 8 0 L 4 5 Z" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ComboBorder" Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260" Margin="0,2,0,0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource ActionBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource TabBodyBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TabPanel Grid.Row="0" IsItemsHost="True" Margin="0,0,0,-1" Panel.ZIndex="1" />
                        <Border Grid.Row="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="0,3,3,3" Padding="12">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" TextElement.Foreground="{StaticResource TextBrush}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0,0,0,2">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource ActionBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource ActionSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource MutedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource ActionBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="Ring" Width="16" Height="16" Stroke="{StaticResource ControlBorderBrush}" Fill="{StaticResource BackgroundBrush}" StrokeThickness="1" HorizontalAlignment="Left" />
                        <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource AccentBrush}" Visibility="Collapsed" HorizontalAlignment="Left" Margin="4,0,0,0" />
                        <ContentPresenter Grid.Column="1" ContentSource="Content" RecognizesAccessKey="True" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource MutedBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource ActionBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="MetricText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{StaticResource MetricFont}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Width" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="PageBefore" Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButton}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Margin="3">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Grip" Background="{StaticResource StrongBorderBrush}" CornerRadius="4" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Grip" Property="Background" Value="{StaticResource ControlBorderBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Grip" Property="Background" Value="{StaticResource MutedBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="PageAfter" Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButton}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto" />
                            <Setter Property="Height" Value="14" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            <Setter TargetName="PageBefore" Property="Command" Value="ScrollBar.PageLeftCommand" />
                            <Setter TargetName="PageAfter" Property="Command" Value="ScrollBar.PageRightCommand" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AcademyAboutWindow" TargetType="Window" BasedOn="{StaticResource AcademyWindow}">
        <Setter Property="Width" Value="500" />
        <Setter Property="MinHeight" Value="420" />
        <Setter Property="SizeToContent" Value="Height" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="WindowStyle" Value="None" />

        <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrongBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="AboutHeading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style></ResourceDictionary>
