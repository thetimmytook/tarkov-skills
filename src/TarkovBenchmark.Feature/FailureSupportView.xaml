<UserControl x:Class="TarkovBenchmark.Feature.FailureSupportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" Foreground="{StaticResource TextBrush}">
  <Border Background="{StaticResource WarningBackgroundBrush}" BorderBrush="{StaticResource WarningBorderBrush}"
          BorderThickness="1" CornerRadius="8" Padding="16">
    <StackPanel>
      <TextBlock Text="Report a problem" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"/>
      <TextBlock x:Name="SupportStatusText" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
      <WrapPanel Margin="0,12,-12,-12">
        <Button x:Name="IssueButton" Content="Open GitHub issue" Margin="0,0,12,12" Click="Issue_Click"/>
        <Button x:Name="ArchiveButton" Content="Show log archive" Margin="0,0,12,12" Click="Archive_Click"/>
        <Button Content="Dismiss" Margin="0,0,12,12" Click="Dismiss_Click"/>
      </WrapPanel>
    </StackPanel>
  </Border>
</UserControl>
