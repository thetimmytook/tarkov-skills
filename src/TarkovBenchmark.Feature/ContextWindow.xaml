<Window x:Class="TarkovBenchmark.Feature.ContextWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Benchmark details" Width="470" Height="390" ResizeMode="NoResize" WindowStyle="None" BorderBrush="#0C0C0C" BorderThickness="1" WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}">
  <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="BENCHMARK DETAILS" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/><TextBlock x:Name="DetectedMapText" Margin="0,8,0,0"/></StackPanel>
    <StackPanel Grid.Row="2"><TextBlock Text="Where did you play?" Foreground="{StaticResource MutedBrush}"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><RadioButton x:Name="BsgRadio" Content="BSG servers" Foreground="{StaticResource TextBrush}" Checked="RequiredField_Changed"/><RadioButton x:Name="LocalRadio" Content="Local" Foreground="{StaticResource TextBrush}" Margin="28,0,0,0" Checked="RequiredField_Changed"/></StackPanel></StackPanel>
    <StackPanel x:Name="MapPanel" Grid.Row="4" Visibility="Collapsed"><TextBlock Text="Map" Foreground="{StaticResource MutedBrush}"/><ComboBox x:Name="MapCombo" Margin="0,7,0,0" SelectionChanged="RequiredField_Changed"/></StackPanel>
    <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Weather (optional)" Foreground="{StaticResource MutedBrush}"/><ComboBox x:Name="WeatherCombo" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Time of day (optional)" Foreground="{StaticResource MutedBrush}"/><ComboBox x:Name="TimeCombo" Margin="0,7,0,0"/></StackPanel></Grid>
    <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Width="92" Click="Cancel_Click"/><Button x:Name="SaveButton" Content="Save benchmark" Width="132" Margin="10,0,0,0" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="Save_Click"/></StackPanel>
  </Grid>
</Window>
