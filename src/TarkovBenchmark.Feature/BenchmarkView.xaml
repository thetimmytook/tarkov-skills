<UserControl x:Class="TarkovBenchmark.Feature.BenchmarkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="620" MinHeight="390"
             Background="{StaticResource BackgroundBrush}"
             Foreground="{StaticResource TextBrush}">
  <Grid Margin="22,16,22,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="16"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="14"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock x:Name="StatusText" Text="Checking benchmark readiness..." FontSize="14" TextWrapping="Wrap"/>
      <TextBlock x:Name="StatusDetailText" Text="No performance data is sent automatically." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
    </StackPanel>

    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="18">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="PERFORMANCE COLLECTION" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
          <TextBlock Text="Duration" Foreground="{StaticResource MutedBrush}" Margin="0,20,0,4"/>
          <TextBlock Text="2 minutes" FontSize="16"/>
          <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
            <Ellipse x:Name="PresentMonDot" Width="9" Height="9" Fill="{StaticResource ErrorBrush}" Margin="0,2,8,0"/>
            <TextBlock x:Name="PresentMonText" Text="Checking bundled PresentMon" TextWrapping="Wrap"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <Button x:Name="StartButton" Content="Start collection" Height="40" Style="{StaticResource PrimaryButton}" Click="Start_Click"/>
          <Button x:Name="CancelButton" Content="Cancel and discard" Height="34" Margin="0,10,0,0" IsEnabled="False" Click="Cancel_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="18">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="LatestResultTitle" Text="LATEST RESULT · NO RUNS" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="CopyResultsButton" Content="Copy results" Padding="12,5" Visibility="Collapsed" IsEnabled="False" Click="CopyResults_Click"/>
          <Button x:Name="OpenFolderButton" Content="Open folder" Padding="12,5" Margin="8,0,0,0" IsEnabled="False" Click="OpenFolder_Click"/>
          <Button x:Name="SubmitButton" Content="Submit" Padding="12,5" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="Submit_Click"/>
        </StackPanel>
        <UniformGrid Grid.Row="1" Grid.ColumnSpan="2" Columns="4" Margin="0,16,0,0">
          <StackPanel><TextBlock Text="Average FPS" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="AverageFpsText" Text="—" FontSize="22" Margin="0,5,0,0"/></StackPanel>
          <StackPanel><TextBlock Text="1% Low" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="OneLowText" Text="—" FontSize="22" Margin="0,5,0,0"/></StackPanel>
          <StackPanel><TextBlock Text="0.1% Low" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="PointOneLowText" Text="—" FontSize="22" Margin="0,5,0,0"/></StackPanel>
          <StackPanel><TextBlock Text="P95 frametime" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="P95Text" Text="—" FontSize="22" Margin="0,5,0,0"/></StackPanel>
        </UniformGrid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
